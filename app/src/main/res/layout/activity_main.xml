<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="D-Tech VPN"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SSH Server IP"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:inputType="textUri"
                android:backgroundTint="#6200EE"
                android:text="sa3.vpnjantit.com" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SSH Port (e.g. 443)"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:inputType="number"
                android:backgroundTint="#6200EE"
                android:text="443" />

            <EditText
                android:id="@+id/etSni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SNI Host (e.g. onlinecms.mtn.co.za)"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:inputType="textUri"
                android:backgroundTint="#6200EE"
                android:text="" />

            <CheckBox
                android:id="@+id/cbEnableCamouflage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable HTTP Camouflage"
                android:textColor="#FFFFFF"
                android:buttonTint="#6200EE"
                android:checked="false"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/layoutPayload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnGeneratePayload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generate Payload"
                    android:backgroundTint="#444444"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etPayload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Payload (Optional)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:backgroundTint="#6200EE"
                    android:text="" />
            </LinearLayout>

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:backgroundTint="#6200EE"
                android:inputType="text" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:backgroundTint="#6200EE"
                android:inputType="textPassword" />

            <CheckBox
                android:id="@+id/cbForceTls12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Force TLS 1.2"
                android:textColor="#FFFFFF"
                android:buttonTint="#6200EE"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advanced Settings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbEnableUdpGw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable UDPGW (Standard Port 7300)"
                android:textColor="#FFFFFF"
                android:buttonTint="#6200EE"
                android:checked="true" />

            <EditText
                android:id="@+id/etUdpGwPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="UDPGW Port"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:inputType="number"
                android:backgroundTint="#6200EE"
                android:text="7300" />

            <EditText
                android:id="@+id/etCustomDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Custom DNS (e.g. 1.1.1.1)"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:inputType="textUri"
                android:backgroundTint="#6200EE"
                android:text="1.1.1.1" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connect"
                android:backgroundTint="#6200EE"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                android:textColor="#AAAAAA"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Logs:"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnCopyLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Copy"
                    android:textSize="10sp"
                    android:backgroundTint="#444444"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnClearLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Clear"
                    android:textSize="10sp"
                    android:backgroundTint="#444444"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="#222222">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textSize="12sp"
                    android:textColor="#00FF00"
                    android:fontFamily="monospace"
                    android:text="Ready..." />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
